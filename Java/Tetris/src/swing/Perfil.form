<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="swing.Perfil">
  <grid id="27dc6" binding="panel_perfil" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="f7599" binding="panel_central" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties>
          <background color="-15059103"/>
        </properties>
        <border type="none"/>
        <children>
          <grid id="473e8" binding="panel_info" layout-manager="GridLayoutManager" row-count="9" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="10" left="10" bottom="10" right="10"/>
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-9535848"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="95b07" class="javax.swing.JLabel" binding="label_horas">
                <constraints>
                  <grid row="5" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                    <preferred-size width="200" height="48"/>
                  </grid>
                </constraints>
                <properties>
                  <background color="-1"/>
                  <foreground color="-16777216"/>
                  <horizontalAlignment value="0"/>
                  <opaque value="true"/>
                  <text value="Label"/>
                </properties>
              </component>
              <component id="a15a6" class="javax.swing.JLabel" binding="label_puntuacion">
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                    <preferred-size width="200" height="48"/>
                  </grid>
                </constraints>
                <properties>
                  <background color="-1"/>
                  <foreground color="-16777216"/>
                  <horizontalAlignment value="0"/>
                  <opaque value="true"/>
                  <text value="Label"/>
                </properties>
              </component>
              <vspacer id="39892">
                <constraints>
                  <grid row="4" column="0" row-span="1" col-span="2" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false">
                    <preferred-size width="-1" height="20"/>
                  </grid>
                </constraints>
              </vspacer>
              <vspacer id="7091e">
                <constraints>
                  <grid row="6" column="0" row-span="1" col-span="2" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false">
                    <preferred-size width="-1" height="20"/>
                  </grid>
                </constraints>
              </vspacer>
              <vspacer id="b6750">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false">
                    <preferred-size width="-1" height="20"/>
                  </grid>
                </constraints>
              </vspacer>
              <vspacer id="39054">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false">
                    <preferred-size width="-1" height="20"/>
                  </grid>
                </constraints>
              </vspacer>
              <grid id="15a88" binding="panel_botones" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
                <margin top="0" left="0" bottom="0" right="0"/>
                <constraints>
                  <grid row="7" column="0" row-span="1" col-span="2" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-9535848"/>
                </properties>
                <border type="none"/>
                <children>
                  <component id="4c7e6" class="javax.swing.JButton" binding="boton_salir">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <background color="-16715009"/>
                      <foreground color="-16777216"/>
                      <text value="Salir Perfil"/>
                    </properties>
                  </component>
                  <component id="1a33a" class="javax.swing.JButton" binding="boton_cerrar">
                    <constraints>
                      <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Cerrar Sesión"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <component id="792c5" class="javax.swing.JLabel" binding="label_nombre">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                    <preferred-size width="200" height="48"/>
                  </grid>
                </constraints>
                <properties>
                  <background color="-1"/>
                  <enabled value="true"/>
                  <foreground color="-16777216"/>
                  <horizontalAlignment value="0"/>
                  <opaque value="true"/>
                  <text value="Label"/>
                </properties>
              </component>
              <vspacer id="1d575">
                <constraints>
                  <grid row="8" column="0" row-span="1" col-span="2" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false">
                    <preferred-size width="-1" height="20"/>
                  </grid>
                </constraints>
              </vspacer>
            </children>
          </grid>
