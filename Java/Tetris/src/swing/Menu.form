<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="swing.Menu">
  <grid id="27dc6" binding="panel_menu" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="953" binding="panel_central" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties>
          <background color="-15059103"/>
        </properties>
        <border type="none"/>
        <children>
          <grid id="242f1" binding="panel_opciones" layout-manager="GridLayoutManager" row-count="7" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="10" left="10" bottom="10" right="10"/>
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="335" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <background color="-9535848"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="7470d" class="javax.swing.JButton" binding="boton_jugar">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-16715009"/>
                  <foreground color="-16777216"/>
                  <text value="Jugar"/>
                </properties>
              </component>
              <vspacer id="8ead5">
                <constraints>
                  <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false">
                    <preferred-size width="-1" height="20"/>
                  </grid>
                </constraints>
              </vspacer>
              <vspacer id="9a5f7">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false">
                    <preferred-size width="-1" height="20"/>
                  </grid>
                </constraints>
              </vspacer>
              <component id="657af" class="javax.swing.JButton" binding="boton_clasificacion">
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-1"/>
                  <foreground color="-16777216"/>
                  <text value="Ver clasificación"/>
                </properties>
              </component>
              <component id="8057c" class="javax.swing.JButton" binding="boton_salir">
                <constraints>
                  <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-1"/>
                  <foreground color="-16777216"/>
                  <text value="Salir Aplicación"/>
                </properties>
              </component>
              <vspacer id="f3aa5">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false">
                    <preferred-size width="-1" height="20"/>
                  </grid>
                </constraints>
              </vspacer>
              <vspacer id="2a614">
                <constraints>
                  <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false">
                    <preferred-size width="-1" height="20"/>
                  </grid>
                </constraints>
              </vspacer>
            </children>
          </grid>
        </children>
      </grid>
      <grid id="5877f" binding="panel_cabecera" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="North"/>
        <properties>
          <background color="-16115409"/>
          <preferredSize width="0" height="17"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="87838" class="javax.swing.JLabel" binding="label_titulo">
            <constraints border-constraint="Center"/>
            <properties>
              <foreground color="-1"/>
              <horizontalAlignment value="0"/>
              <text value="TETRIS"/>
            </properties>
          </component>
          <component id="d6951" class="javax.swing.JLabel" binding="label_imagen">
            <constraints border-constraint="West"/>
            <properties>
              <text value=""/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
