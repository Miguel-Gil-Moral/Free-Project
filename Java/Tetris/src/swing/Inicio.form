<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="swing.Inicio">
  <grid id="27dc6" binding="panel_inicio" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="5" y="5" width="500" height="400"/>
    </constraints>
    <properties>
      <background color="-15059103"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="389e2" binding="panel_cabecera" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="North"/>
        <properties>
          <background color="-16115409"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="c9bf4" class="javax.swing.JLabel" binding="label_titulo">
            <constraints border-constraint="Center"/>
            <properties>
              <foreground color="-1"/>
              <horizontalAlignment value="0"/>
              <text value="TETRIS"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="9ec94" binding="panel_central" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties>
          <background color="-15059103"/>
        </properties>
        <border type="none"/>
        <children>
          <grid id="57fe4" binding="panel_registro" layout-manager="GridLayoutManager" row-count="9" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="10" left="10" bottom="10" right="10"/>
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="335" height="136"/>
              </grid>
            </constraints>
            <properties>
              <background color="-9535848"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="44212" class="javax.swing.JTextField" binding="campo_nombre">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties>
                  <text value="Introduce el nombre"/>
                </properties>
              </component>
              <component id="f016a" class="javax.swing.JPasswordField" binding="campo_contrasenya">
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties>
                  <echoChar value="*"/>
                  <editable value="true"/>
                  <enabled value="true"/>
                  <text value="Introduce la contraseña"/>
                </properties>
              </component>
              <component id="e4192" class="javax.swing.JButton" binding="boton_crear">
                <constraints>
                  <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-16715009"/>
                  <foreground color="-16777216"/>
                  <text value="Crear Cuenta"/>
                </properties>
              </component>
              <component id="93ed7" class="javax.swing.JLabel" binding="label_pregunta">
                <constraints>
                  <grid row="7" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <foreground color="-1"/>
                  <text value="¿Ya tienes cuenta?"/>
                </properties>
              </component>
              <vspacer id="9ee66">
                <constraints>
                  <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false">
                    <preferred-size width="-1" height="10"/>
                  </grid>
                </constraints>
              </vspacer>
              <vspacer id="3caf3">
                <constraints>
                  <grid row="8" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false">
                    <preferred-size width="-1" height="10"/>
                  </grid>
                </constraints>
              </vspacer>
              <vspacer id="57e9b">
                <constraints>
                  <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false">
                    <preferred-size width="-1" height="10"/>
                  </grid>
                </constraints>
              </vspacer>
              <vspacer id="75092">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false">
                    <preferred-size width="-1" height="10"/>
                  </grid>
                </constraints>
              </vspacer>
              <vspacer id="2f2ba">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false">
                    <preferred-size width="-1" height="20"/>
                  </grid>
                </constraints>
              </vspacer>
            </children>
          </grid>
        </children>
      </grid>
    </children>
  </grid>
</form>
